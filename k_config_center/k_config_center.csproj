<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- 生成 XML 注释文件供 Swagger 展示接口文档；1591（成员缺注释告警）压掉，保持 0 警告构建 -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="SqlSugarCore" Version="5.1.4.216" />
        <!-- 仅用于顶替 SqlSugarCore 传递引用的漏洞版本 2.1.11（NU1903 / CVE-2025-6965），项目并不使用 SQLite -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

</Project>
