# 编辑器统一格式(后端 4 空格 / 前端 2 空格,UTF-8,LF)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{ts,tsx,json,html,css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,yml,yaml,sql}]
indent_style = space
indent_size = 2

[*.csproj]
indent_style = space
indent_size = 4
